{
  "mcpServers": {
    "seekwide": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/src/index.js"],
      "env": {
        "SEEKWIDE_DATA_DIR": "${CLAUDE_PLUGIN_DATA}",
        "SEEKWIDE_REPORT_BRAND": "${user_config.report_brand_name}",
        "SEEKWIDE_REPORT_LOGO": "${user_config.report_logo_path}",
        "SEEKWIDE_GOOGLE_API_KEY": "${user_config.google_api_key}"
      }
    }
  }
}
